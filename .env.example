# ---------------------------------------------------------------------------
# SHUNYA — environment template. Copy to `.env.local` and fill in real values.
# Nothing in this file is a real business detail; every value is a placeholder.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://shunya.example

# --- Contact placeholders -------------------------------------------------
# Replace with the company's real, verified details before launch.
NEXT_PUBLIC_CONTACT_EMAIL=hello@shunya.example
NEXT_PUBLIC_CONTACT_PHONE=+910000000000
# WhatsApp number in international format WITHOUT "+" or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/shunya.example

# --- Analytics (optional) -------------------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# --- Abuse protection (optional) -----------------------------------------
# Enquiries accepted per IP per window. Raise on staging or an office network
# that shares one public address.
ENQUIRY_RATE_LIMIT=12
ENQUIRY_RATE_WINDOW_MINUTES=10

# Failed studio sign-ins tolerated per IP before a temporary lockout. Successful
# sign-ins clear the counter, so a real admin cannot lock themselves out.
LOGIN_RATE_LIMIT=8
LOGIN_RATE_WINDOW_MINUTES=15

# --- Enquiry routing (optional) ------------------------------------------
# Formspree / Basin / Resend endpoint. Leave blank and enquiries are stored
# in the admin inbox instead (data/enquiries.json).
ENQUIRY_WEBHOOK_URL=
# Shared secret required by the admin API. Change this.
ADMIN_TOKEN=shunya-dev-token-change-me
